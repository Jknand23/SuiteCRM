# SuiteCRM Docker Environment Configuration
# Copy this file to .env.docker and customize the values

# Database Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=suitecrm
MYSQL_USER=suitecrm
MYSQL_PASSWORD=suitecrm_password

# SuiteCRM Configuration
SUITECRM_SITE_URL=http://localhost:8080
SUITECRM_ADMIN_USERNAME=admin
SUITECRM_ADMIN_PASSWORD=admin123
SUITECRM_SYSTEM_NAME=SuiteCRM

# Optional: OAuth2 Configuration (set enabled=true in config_override.php when ready)
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=

# Development Settings
SUITECRM_LOG_LEVEL=info
SUITECRM_ENABLE_DEBUG=false

# Timezone (optional, defaults to UTC)
SUITECRM_TIMEZONE=UTC 